#!/bin/sh
# Block commits that contain secrets. Free, local-only guardrail.
# Requires gitleaks: https://github.com/gitleaks/gitleaks
#   Windows: choco install gitleaks   (or) scoop install gitleaks
#   macOS:   brew install gitleaks
#
# This hook is auto-wired by the "prepare" script in package.json
# (sets core.hooksPath to .githooks on `npm install`).

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "⚠  gitleaks not installed — skipping secret scan."
  echo "   Install it so this guardrail actually protects you:"
  echo "   https://github.com/gitleaks/gitleaks"
  exit 0
fi

gitleaks git --staged --redact --no-banner
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "✖  gitleaks found a potential secret in your staged changes — commit blocked."
  echo "   Move the value into Infisical and reference it via env."
  echo "   If it's a false positive, add an allowlist entry to .gitleaks.toml."
  exit 1
fi


# GUARDRAIL: check-localhost-fallback (propagated — do not hand-edit this block)
staged_source=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$')
if [ -n "$staged_source" ]; then
  hook_dir=$(dirname "$0")
  checker="$hook_dir/check-localhost-fallback.mjs"
  if [ -f "$checker" ]; then
    localhost_hits=$(node "$checker" $staged_source)
    if [ -n "$localhost_hits" ]; then
      echo "⚠  possible unguarded localhost fallback (this bug class has shipped to prod 3x):"
      echo "$localhost_hits" | sed 's/^/   /'
    fi
  else
    echo "⚠  localhost-fallback checker not found at $checker — guardrail is not active in this repo (run scripts/propagate-guardrail.mjs from stanton-control to install it)."
  fi
fi
# END GUARDRAIL

exit 0
